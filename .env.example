# MailXP local development environment template.
# Copy this file to .env and replace placeholders with your own values.
# .env is git-ignored. Never commit real credentials or paste them into chat.

# PostgreSQL connection string for local development.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/mailxp_dev?schema=public"

# Optional: Google OAuth for account connection and sign-in.
# Create an OAuth Web application client in Google Cloud Console and configure
# the consent screen and authorized redirect URI before enabling these values.
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/callbacks/googleOAuth"

# Generate a stable 32-byte key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY="YOUR_BASE64_ENCODED_32_BYTE_KEY"

# Optional: AI email analysis (Phase B10). Advisory-only summaries/categories
# for synced Gmail messages. Without a key the feature fails closed (503 on
# the analysis routes; the Settings AI card hides). Create a key in Google
# AI Studio (https://aistudio.google.com/apikey). NEVER commit a real key.
GEMINI_API_KEY=""
# Model id for the analysis provider (server default: gemini-2.5-flash).
GEMINI_MODEL="gemini-2.5-flash"
# Daily analysis budget per player per UTC day (server default: 20).
AI_DAILY_LIMIT=20
